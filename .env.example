# NextGen Eval Environment Configuration Example
# Do not commit real secrets or production keys here.

# Server Port
PORT=3000

# Gemini API Key (Server-Side Only - Never Exposed to Browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Evaluation Model (Gemini 3.8 Flash recommended for high speed and accurate multimodal reasoning)
GEMINI_MODEL=gemini-3.8-flash

# Worker Concurrency Limit (Bounded concurrency to prevent Gemini RPM quota exhaustion)
MAX_CONCURRENT_EVALS=4

# Request Timeout (Milliseconds)
REQUEST_TIMEOUT_MS=90000

# Persistent Data Storage Path
DATA_DIR=./.data/evaluations

# Node Environment
NODE_ENV=development
