# NextGen Eval Environment Configuration
# Do not commit real secrets or production keys here.

# Server Port
PORT=3000

# Security: Google Gemini API Access (Server-Side Only)
# GEMINI_API_KEY is used exclusively by backend processes to invoke Google Gemini models
# for multimodal handwriting transcription, diagram analysis, and rubric evaluation.
# CRITICAL: Never expose this key in client bundles, browser localStorage, or frontend code.
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Evaluation Model (Gemini 2.5 / 3.8 Flash recommended for speed & multimodal handwriting/rubrics)
GEMINI_MODEL=gemini-2.5-flash

# Worker Concurrency Limit (Bounded pool to prevent Gemini rate limit / quota exhaustion)
MAX_CONCURRENT_EVALS=4

# Request Timeout (Milliseconds)
REQUEST_TIMEOUT_MS=90000

# Persistent Data Storage Path (Local disk for recovery across restarts)
DATA_DIR=./.data/evaluations

# Node Environment ('development' or 'production')
NODE_ENV=development

# Security: Configurable Explicit CORS Allowlist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Security: Server Authentication API Keys / Tokens (RBAC & Multi-Tenant Isolation)
# OPERATOR_API_KEY is genuinely required for system operator privileges:
# - Access to system operational metrics (/api/metrics)
# - Access to full diagnostic telemetry (/ready)
# - Maintenance pruning of evaluation records (/api/evaluations/prune)
# - Cross-institution usage statistics and cost audit (/api/usage/summary)
# - Cross-tenant inspection for troubleshooting stuck jobs
# NOTE: OPERATOR_API_KEY is completely distinct from GEMINI_API_KEY. Never expose either key in frontend code or client bundles.
OPERATOR_API_KEY=nextgen_op_sec_token_9921
ADMIN_API_KEY=nextgen_admin_sec_token_7733
INSTRUCTOR_API_KEY=nextgen_inst_sec_token_4412
EVALUATOR_API_KEY=nextgen_eval_sec_token_1188
AUTH_SECRET=nextgen_auth_secret_key_8841

# Performance & Benchmarking (Opt-in live model evaluation with real measured metrics)
RUN_LIVE_BENCHMARK=false
